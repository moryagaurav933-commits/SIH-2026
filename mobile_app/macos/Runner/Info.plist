<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>

	<!-- Privacy Descriptions for Camera, Microphone, and Location -->
	<key>NSCameraUsageDescription</key>
	<string>Krishi-Saarthi requires camera access to capture leaf photos for AI crop disease diagnosis and insurance evidence verification.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Krishi-Saarthi requires microphone access for voice copilot and speech interaction in Indian languages.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Krishi-Saarthi uses your location to fetch hyperlocal weather alerts, nearest mandi commodity prices, and geo-tagged insurance claims.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Krishi-Saarthi uses location for real-time crop disease hotspot telemetry and localized emergency weather broadcasts.</string>

	<!-- App Transport Security for local development and backend sync -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
